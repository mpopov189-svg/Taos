# Demo starts with 500 fictional EUR, requires no account.
MODE=paper
DATA_DIR=./data
PORT=8080
# Optional password for mobile dashboard (required with connected OKX).
BOT_PASSWORD=

# OPTIONAL, only for OKX's official demo environment:
# MODE=okx_demo
# OKX_API_KEY=
# OKX_API_SECRET=
# OKX_API_PASSPHRASE=

# REAL TRADING IS OFF BY DEFAULT. For knowledgeable owners ONLY:
# MODE=live
# ENABLE_LIVE=1
# LIVE_RISK_ACK=I_ACCEPT_REAL_LOSSES
# PERSISTENT_VOLUME_CONFIRMED=YES
# OKX_API_KEY=
# OKX_API_SECRET=
# OKX_API_PASSPHRASE=
